# Local Python URLs; Docker Compose overrides these with internal service names.
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
# Use transaction only for a Supabase pooler on a serverless deployment.
# It preserves DATABASE_URL credentials and switches the same pooler to port 6543.
DATABASE_POOLER_MODE=configured
QDRANT_URL=http://localhost:6333
# Gemini Developer API; one key for chat and embeddings.
GEMINI_API_KEY=
# Server-only Fernet key for business-owned Gemini keys; keep stable across deploys.
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
INTEGRATION_ENCRYPTION_KEY=
# Explicit cache: created on daytime traffic; expires at the end hour in the business timezone.
GEMINI_CACHE_ENABLED=true
GEMINI_CACHE_START_HOUR=10
GEMINI_CACHE_END_HOUR=22
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072
# Change prefix when embedding model/dimensions/configuration changes; rebuild both indexes.
INDEX_PREFIX=agent_gemini_embedding_2_3072
SUPPORT_WEBHOOK_URL=
SUPPORT_WEBHOOK_TOKEN=
# Web Push signing key: generate with python -m context_agent.push_keys /private/path/push.env
# Keep the same private key across deployments; never prefix it with VITE_.
PUSH_VAPID_PRIVATE_KEY=
# A monitored contact email, for example mailto:admin@your-domain.example
PUSH_VAPID_SUBJECT=
LANGSMITH_TRACING=false

# Server-only signing secret, at least 32 random bytes; never use a VITE_ variable.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SUPER_ADMIN_JWT_SECRET=
SUPER_ADMIN_TOKEN_MINUTES=2880
SUPER_ADMIN_LOGIN_MAX_ATTEMPTS=5
SUPER_ADMIN_LOGIN_LOCK_SECONDS=900

# Local-only pgAdmin login (separate from PostgreSQL credentials).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=agent-local-admin

CANDIDATE_LIMIT=30
KNOWLEDGE_LIMIT=4
TOOL_LIMIT=5
MAX_TOOL_ROUNDS=2
RELEVANCE_THRESHOLD=0.60
